//// log — the five levels.
////
//// FIVE LEVELS, ranked: trace 0 · debug 1 · info 2 · warn 3 · error 4. A
//// spelling read from configuration ranks through `rankOf`, which also knows
//// `off` (5) — a threshold, never the level of a record. The mapping onto
//// OTP's eight severities is stated, not inferred (`otpLevel`): Trace and
//// Debug both become `debug`, so a sink that filters must filter on the rank
//// before the host call, as `LogSink.enabled` does.
////
//// PER-NAME LEVELS (decision 349). A `Threshold` is a lowest level on, or
//// `Off`. `Levels` maps logger names to thresholds: a threshold set on a
//// name applies to it and to every dotted name beneath it, the longest
//// prefix set wins, and `root` applies when none is. A name set twice, an
//// empty name and a name with an empty segment are refused (`levelsProblem`
//// when a sink is built, a panic when one is resolved) — never a guess at
//// which entry wins.
////
//// Moved from rakun-logging's `levels.bp` (decision 195). Where the names and
//// their thresholds come from — rakun's typed configuration, its groups, the
//// `loggers` endpoint's run-time overrides — is the framework's: it builds a
//// `Levels` and installs a sink over it again when one changes.

pub type Level {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

// The lowercase name: `trace`, `debug`, `info`, `warn`, `error`.
pub fn levelName(level: Level) -> string {
    val name = case level {
        Level.Trace -> "trace";
        Level.Debug -> "debug";
        Level.Info -> "info";
        Level.Warn -> "warn";
        Level.Error -> "error";
    };
    return name;
}

// Ranks: trace 0 · debug 1 · info 2 · warn 3 · error 4.
pub fn levelRank(level: Level) -> i32 {
    val rank = case level {
        Level.Trace -> 0;
        Level.Debug -> 1;
        Level.Info -> 2;
        Level.Warn -> 3;
        Level.Error -> 4;
    };
    return rank;
}

// The OTP `logger` severity a level is written at.
pub fn otpLevel(level: Level) -> string {
    val name = case level {
        Level.Trace -> "debug";
        Level.Debug -> "debug";
        Level.Info -> "info";
        Level.Warn -> "warning";
        Level.Error -> "error";
    };
    return name;
}

// The spellings `rankOf` accepts, for a diagnostic that lists them.
pub fn validLevels() -> string {
    return "trace, debug, info, warn, error, off";
}

// The rank a spelling names, `-1` for one that is not a level. `warning` is
// accepted as OTP's name for `warn`, `off` is 5, case and surrounding
// whitespace do not matter.
pub fn rankOf(raw: string) -> i32 {
    val v = raw.trim().toLower();
    if (v == "trace") return 0;
    if (v == "debug") return 1;
    if (v == "info") return 2;
    if (v == "warn" || v == "warning") return 3;
    if (v == "error") return 4;
    if (v == "off") return 5;
    return -1;
}

// The uppercase name of a rank, as the renderers write it; `OFF` for any rank
// that is not one of the five.
pub fn rankName(rank: i32) -> string {
    if (rank == 0) return "TRACE";
    if (rank == 1) return "DEBUG";
    if (rank == 2) return "INFO";
    if (rank == 3) return "WARN";
    if (rank == 4) return "ERROR";
    return "OFF";
}

// ── per-name levels ─────────────────────────────────────────────────────────

// The lowest level a logger name (or a sink) takes, or none.
pub type Threshold {
    From(level: Level),
    Off,
}

// The threshold a spelling names — the spellings `rankOf` reads, `off`
// among them. Any other spelling is refused, naming the accepted ones.
pub fn parseThreshold(name: string) -> @Result<Threshold, string> {
    val rank = rankOf(name);
    if (rank == 0) return Threshold.From(level: Level.Trace);
    if (rank == 1) return Threshold.From(level: Level.Debug);
    if (rank == 2) return Threshold.From(level: Level.Info);
    if (rank == 3) return Threshold.From(level: Level.Warn);
    if (rank == 4) return Threshold.From(level: Level.Error);
    if (rank == 5) return Threshold.Off;
    throw "log.parseThreshold: \""
        + name
        + "\" is not a level - accepted: "
        + validLevels();
}

// Whether a record at `level` passes `threshold`.
pub fn thresholdAdmits(threshold: Threshold, level: Level) -> bool {
    val admits = case threshold {
        From(lowest) -> levelRank(level) >= levelRank(lowest);
        Off -> false;
    };
    return admits;
}

// The thresholds of a program's loggers: `root`, and one per name.
pub type Levels(
    root: Threshold,
    names: Array<#(string, Threshold)>,
)

// The first reason `levels` cannot be resolved, or "": an empty name, a name
// with an empty segment (`a..b`, `.a`, `a.`), a name set twice.
pub fn levelsProblem(levels: Levels) -> string {
    var problem = "";
    var seen: string[] = [];
    for (levels.names) { entry ->
        if (problem == "") problem = nameProblem(entry._0, seen);
        seen.push(entry._0);
    }
    return problem;
}

fn nameProblem(name: string, seen: string[]) -> string {
    if (name == "") return "log.Levels: a logger name is empty";
    if (name.split(".").contains(""))
        return "log.Levels: the logger name \""
            + name
            + "\" has an empty segment";
    if (seen.contains(name))
        return "log.Levels: the logger name \"" + name + "\" is set twice";
    return "";
}

fn setOn(levels: Levels, name: string) -> Array<Threshold> {
    var found: Array<Threshold> = [];
    for (levels.names) { entry ->
        if (entry._0 == name) found.push(entry._1);
    }
    return found;
}

// The threshold in force for `logger`: the one set on the longest dotted
// prefix of the name (the name itself first), else `root`. A prefix set
// twice panics, naming it.
pub fn thresholdFor(levels: Levels, logger: string) -> Threshold {
    var parts: string[] = logger.split(".");
    var found: Array<Threshold> = [];
    while (found.length == 0 && parts.length > 0) {
        val prefix = parts.join(".");
        found = setOn(levels, prefix);
        if (found.length > 1)
            @panic(
                "log.Levels: the logger name \"" + prefix + "\" is set twice",
            );
        parts = parts.slice(0, parts.length - 1);
    }
    return found.at(0) ?? levels.root;
}

// Whether a record at `level` from `logger` passes the levels in force.
pub fn levelEnabled(levels: Levels, logger: string, level: Level) -> bool {
    return thresholdAdmits(thresholdFor(levels, logger), level);
}

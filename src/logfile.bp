//// log — a file sink with rotation (decision 349).
////
//// `fileSink(file, format, levels)` appends each record it takes to
//// `file.path` as one `format` line, creating the directories on the way.
//// ROTATION is `logger_std_h`'s, written here once so every target rotates
//// alike: after a write leaves the file at `maxBytes` or more, the file
//// becomes `<path>.0`, `<path>.0` becomes `<path>.1`, … and
//// `<path>.<maxFiles - 1>` is deleted; with `maxFiles` 0 the file is deleted
//// and starts again. So the live file and its archives never hold more than
//// `maxFiles + 1` files.
////
//// Every host call fails loudly and typed (decisions 431, 921): the four file
//// cells write `result: true`, and a line that cannot be appended, a size that
//// cannot be read (other than a file that is not there), a rename or a delete
//// that fails answers `Error` of `LogError` — never a raise; a log that
//// silently stops writing is a lost log. A file that is not there reads `-1`
//// bytes and is skipped by a rename or a delete. The sink `fileSink` builds
//// answers `-1` for a record it could not write (`0` for one it did).
////
//// Ported from rakun-logging's `install_file` (OTP `logger_std_h`
//// `max_no_bytes` / `max_no_files`); the total size cap that rakun folds into
//// the archive count stays rakun's (it hands `fileSink` the folded count).

import {levels.Levels, levels.levelEnabled, levels.levelsProblem};
import {formats.Format, formats.renderRecord};
import {sink.LogSink};
import {failure.HostError, compiler} from "std";

// The file a `fileSink` writes: its path, the size that rotates it, and the
// archives kept.
pub type LogFile(
    path: string,
    maxBytes: i64,
    maxFiles: i32,
)

// The error of the file sink (decision 921): the host call that failed, the path it was
// given and the host's own text. One variant per cell, so a failed rotation names the step.
pub type LogError {
    AppendFailed(path: string, message: string),
    SizeFailed(path: string, message: string),
    MoveFailed(path: string, message: string),
    RemoveFailed(path: string, message: string),

    // The error's text: `<what>: <path>: <host text>`, the same on every target.
    pub fn message(self: Self) -> string {
        return case self {
            AppendFailed(path: path, message: message) -> "cannot append to "
                + path
                + ": "
                + message;
            SizeFailed(path: path, message: message) -> "cannot read the size of "
                + path
                + ": "
                + message;
            MoveFailed(path: path, message: message) -> "cannot move "
                + path
                + ": "
                + message;
            RemoveFailed(path: path, message: message) -> "cannot remove "
                + path
                + ": "
                + message;
        };
    }
}

// LANGUAGE GAP: wasm has no binding that reaches the file system — the four file cells are refused on wasm.
#[compiler.external(
    .JavaScript("""(function(__P, __L){ var __fs = require('fs'); __fs.mkdirSync(require('path').dirname(__P), { recursive: true }); __fs.appendFileSync(__P, __L + "\n"); return 0; })($0, $1)""", result: true),
    .Erlang("""(fun(LgP__, LgL__) -> case filelib:ensure_dir(LgP__) of ok -> case file:write_file(LgP__, [LgL__, <<"\n">>], [append]) of ok -> {ok, 0}; {error, LgR__} -> {error, LgR__} end; {error, LgR__} -> {error, LgR__} end end)($0, $1)""", result: true),
)]
declare fn appendLine(path: string, line: string) -> Result<i32, HostError>;

#[compiler.external(
    .JavaScript("""(function(__P){ var __fs = require('fs'); return __fs.existsSync(__P) ? __fs.statSync(__P).size : -1; })($0)""", result: true),
    .Erlang("""(fun(LgP__) -> case file:read_file_info(LgP__) of {ok, LgI__} -> {ok, element(2, LgI__)}; {error, enoent} -> {ok, -1}; {error, LgR__} -> {error, LgR__} end end)($0)""", result: true),
)]
declare fn fileBytes(path: string) -> Result<i64, HostError>;

#[compiler.external(
    .JavaScript("""(function(__F, __T){ var __fs = require('fs'); if (__fs.existsSync(__F)) __fs.renameSync(__F, __T); return 0; })($0, $1)""", result: true),
    .Erlang("""(fun(LgF__, LgT__) -> case file:rename(LgF__, LgT__) of ok -> {ok, 0}; {error, enoent} -> {ok, 0}; {error, LgR__} -> {error, LgR__} end end)($0, $1)""", result: true),
)]
declare fn moveFile(source: string, target: string) -> Result<i32, HostError>;

#[compiler.external(
    .JavaScript("""(function(__P){ var __fs = require('fs'); if (__fs.existsSync(__P)) __fs.unlinkSync(__P); return 0; })($0)""", result: true),
    .Erlang("""(fun(LgP__) -> case file:delete(LgP__) of ok -> {ok, 0}; {error, enoent} -> {ok, 0}; {error, LgR__} -> {error, LgR__} end end)($0)""", result: true),
)]
declare fn removeFile(path: string) -> Result<i32, HostError>;

// A host cell's answer, its failure read as a `LogError` of `path` (decision 921).
fn liftAppend(path: string, r: Result<i32, HostError>) -> Result<i32, LogError> {
    case r {
        Ok(v) -> return v;
        Error(e) -> throw LogError.AppendFailed(path: path, message: e.message);
    }
}

fn liftSize(path: string, r: Result<i64, HostError>) -> Result<i64, LogError> {
    case r {
        Ok(v) -> return v;
        Error(e) -> throw LogError.SizeFailed(path: path, message: e.message);
    }
}

fn liftMove(path: string, r: Result<i32, HostError>) -> Result<i32, LogError> {
    case r {
        Ok(v) -> return v;
        Error(e) -> throw LogError.MoveFailed(path: path, message: e.message);
    }
}

fn liftRemove(path: string, r: Result<i32, HostError>) -> Result<i32, LogError> {
    case r {
        Ok(v) -> return v;
        Error(e) -> throw LogError.RemoveFailed(path: path, message: e.message);
    }
}

// The first reason `file` cannot be written, or "".
pub fn logFileProblem(file: LogFile) -> string {
    if (file.path == "") return "log.LogFile: the path is empty";
    if (file.maxBytes <= 0)
        return "log.LogFile: maxBytes is "
            + file.maxBytes.toString()
            + ", and a file rotates at a size of at least 1 byte";
    if (file.maxFiles < 0)
        return "log.LogFile: maxFiles is "
            + file.maxFiles.toString()
            + ", and the archives kept are 0 or more";
    return "";
}

// The name of archive `index` of `path`: `<path>.<index>`, `.0` the newest.
pub fn archiveName(path: string, index: i32) -> string {
    return path + "." + index.toString();
}

// The size of the file at `path` in bytes, `-1` when there is none.
pub fn logFileBytes(path: string) -> Result<i64, LogError> {
    val n = try liftSize(path, fileBytes(path));
    return n;
}

// Shift the archives one up, the oldest out, and the live file to `.0`.
pub fn rotate(file: LogFile) -> Result<i32, LogError> {
    if (file.maxFiles == 0) {
        val gone = try liftRemove(file.path, removeFile(file.path));
        return gone;
    }
    val oldest = archiveName(file.path, file.maxFiles - 1);
    val _o = try liftRemove(oldest, removeFile(oldest));
    var i = file.maxFiles - 2;
    while (i >= 0) {
        val source = archiveName(file.path, i);
        val _m = try liftMove(source, moveFile(source, archiveName(file.path, i
            + 1)));
        i = i - 1;
    }
    val first = try liftMove(file.path, moveFile(file.path, archiveName(file.path, 0)));
    return first;
}

// Append `line` and rotate when the file reached `maxBytes`. Answers 0, or the
// `LogError` of the host call that failed.
pub fn appendRotating(file: LogFile, line: string) -> Result<i32, LogError> {
    val _a = try liftAppend(file.path, appendLine(file.path, line));
    val size = try logFileBytes(file.path);
    if (size >= file.maxBytes) val _r = try rotate(file);
    return 0;
}

// What the sink's `write` answers for a record: 0 written, -1 not (the `LogError` is
// the one `appendRotating` answers).
fn writeAnswer(r: Result<i32, LogError>) -> i32 {
    return case r {
        Ok(n) -> n;
        Error(_) -> -1;
    };
}

// A sink appending each record it takes to `file` as one `format` line,
// rotating it. A record passes when `levels` admits its logger and level.
// Refused when `file` or `levels` cannot be used.
pub fn fileSink(
    file: LogFile,
    format: Format,
    levels: Levels,
) -> Result<LogSink, string> {
    val fileProblem = logFileProblem(file);
    if (fileProblem != "") throw "log.fileSink: " + fileProblem;
    val levelsText = levelsProblem(levels);
    if (levelsText != "") throw "log.fileSink: " + levelsText;
    return LogSink(
        enabled: { logger, level -> levelEnabled(levels, logger, level) },
        write: { r -> writeAnswer(appendRotating(file, renderRecord(format, r))) },
    );
}
